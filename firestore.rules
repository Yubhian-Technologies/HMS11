rules_version = '2';

// Design rationale: docs/12-security-rules.md. Scope helpers here are the
// literal implementation of docs/12-security-rules.md §12.2 — every
// collection block below reuses these instead of redefining its own checks.
//
// NESTED HIERARCHY (docs/09-firestore-design.md §9.1, docs/10-collections-
// schema.md): branch-operational collections live at
// hospitals/{hospitalId}/branches/{branchId}/{collection} — tenant scope is
// derived from these PATH SEGMENTS, not from resource.data fields, which is
// structurally stronger (a path segment can't be spoofed by a malformed
// document the way a data field could be). `departments` is hospital-scoped
// (a department spans every branch of its hospital), not branch-scoped.
// `users`, `patients`, `notifications`, and `auditLogs` stay flat top-level
// (global/ownership-scoped — see docs/09-firestore-design.md §9.1.2 and the
// CLAUDE.md changelog for why auditLogs and notifications deviate from the
// original doc 10 tree diagram).
//
// Doctors live at hospitals/{h}/branches/{b}/doctors/{uid} (renamed from the
// old flat `doctorProfiles`), with `availabilityTemplates`/`slots` nested
// under that. `wards`/`rooms`/`beds` are three sibling branch-level
// collections (not physically nested in each other) — see paths.ts's doc
// comment for why.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function claim(key) {
      return request.auth.token[key];
    }

    function hasRole(roles) {
      return isSignedIn() && claim('role') in roles;
    }

    // Platform scope — super_admin only, no hospital match required.
    function isSuperAdmin() {
      return hasRole(['super_admin']);
    }

    // Hospital scope — role's hospitalId claim must match the PATH segment.
    function isHospitalScoped(hospitalId) {
      return isSignedIn() && claim('hospitalId') == hospitalId;
    }

    // Branch scope — hospitalId AND branchId claims must match the PATH segments.
    function isBranchScoped(hospitalId, branchId) {
      return isHospitalScoped(hospitalId) && claim('branchId') == branchId;
    }

    // Ownership scope — patient's own uid must match the resource's patientId (cross-hospital).
    function isOwner(resource) {
      return isSignedIn() && claim('role') == 'patient' && resource.data.patientId == request.auth.uid;
    }

    // FR-2.6: a disabled hospital's data becomes inaccessible to its own
    // staff, even before their refresh tokens are revoked. Super Admin is
    // exempt (needs to see/re-enable disabled hospitals); patients are
    // exempt (ownership-scoped, history must stay visible).
    function isActiveHospital(hospitalId) {
      return get(/databases/$(database)/documents/hospitals/$(hospitalId)).data.status == 'active';
    }

    function onlyFieldsChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // -------------------------------------------------------------------
    // Flat, global collections (docs/09-firestore-design.md §9.1.2)
    // -------------------------------------------------------------------

    // users/{uid} — every role including patient. Doc id == Firebase Auth uid.
    match /users/{uid} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && request.auth.uid == uid)
        || (hasRole(['admin']) && isHospitalScoped(resource.data.hospitalId))
        || (hasRole(['office', 'reception', 'nurse', 'doctor', 'pharmacy', 'lab'])
            && isBranchScoped(resource.data.hospitalId, resource.data.branchId));

      // Staff accounts are provisioned only by Admin, for their own hospital.
      allow create: if hasRole(['admin']) && isHospitalScoped(request.resource.data.hospitalId);

      // A user may edit their own non-privileged fields; Admin may edit any
      // field on staff within their hospital (e.g. reassigning branch/role).
      allow update: if (isSignedIn() && request.auth.uid == uid
          && onlyFieldsChanged(['name', 'phone', 'photoUrl', 'fcmTokens', 'updatedAt']))
        || (hasRole(['admin']) && isHospitalScoped(resource.data.hospitalId));

      allow delete: if false; // no hard deletes anywhere
    }

    // patients/{patientId} — global; a patient may be treated at multiple
    // hospitals. hospitalId is null for a self-registered patient (ownership
    // scope only) and set only for a Reception walk-in record.
    match /patients/{patientId} {
      allow read: if isSuperAdmin()
        || (hasRole(['admin']) && resource.data.hospitalId != null && isHospitalScoped(resource.data.hospitalId))
        || (hasRole(['office', 'reception', 'nurse']) && resource.data.branchId != null
            && isBranchScoped(resource.data.hospitalId, resource.data.branchId))
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if (hasRole(['patient']) && request.auth.uid == patientId
          && request.resource.data.userId == request.auth.uid)
        || (hasRole(['reception']) && request.resource.data.userId == null);

      allow update: if (hasRole(['patient']) && resource.data.userId == request.auth.uid)
        || (resource.data.userId == null && (hasRole(['reception']) || hasRole(['admin'])))
        || isSuperAdmin();

      allow delete: if false;
    }

    // notifications/{id} — flat for every recipient (staff and patient
    // alike): a notification is addressed by userId, never queried
    // cross-user, so branch-nesting it would add path complexity with no
    // isolation benefit (deviation from the doc 10 tree diagram — see
    // CLAUDE.md changelog). Written exclusively by the server-side
    // sendNotification() helper (Admin SDK, bypasses rules).
    match /notifications/{id} {
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if false;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
        && onlyFieldsChanged(['read', 'updatedAt']);
      allow delete: if false;
    }

    // auditLogs/{id} — flat/platform-level (kept flat, not nested — see
    // CLAUDE.md changelog: super_admin actions like createHospital have no
    // branch, sometimes no hospital, to nest under). Append-only, written
    // exclusively by the server-side writeWithAudit() service.
    match /auditLogs/{id} {
      allow read: if isSuperAdmin() || (hasRole(['admin']) && isHospitalScoped(resource.data.hospitalId));
      allow write: if false;
    }

    // -------------------------------------------------------------------
    // Nested hierarchy: hospitals/{hospitalId}/...
    // -------------------------------------------------------------------
    match /hospitals/{hospitalId} {
      allow read: if isSuperAdmin() || (hasRole(['admin']) && isHospitalScoped(hospitalId));
      // Editing/disabling is super_admin only.
      allow create, update: if isSuperAdmin();
      allow delete: if false;

      // departments — hospital-scoped (spans every branch of the hospital).
      match /departments/{departmentId} {
        allow read: if isSuperAdmin()
          || (hasRole(['admin']) && isHospitalScoped(hospitalId))
          || (hasRole(['office', 'reception', 'nurse', 'doctor']) && isHospitalScoped(hospitalId))
          || hasRole(['patient']);
        allow create, update: if hasRole(['admin']) && isHospitalScoped(hospitalId);
        allow delete: if false;
      }

      // holidays — hospital-wide calendar.
      match /holidays/{holidayId} {
        allow read: if isSuperAdmin()
          || (hasRole(['admin']) && isHospitalScoped(hospitalId))
          || (hasRole(['office', 'reception', 'nurse', 'doctor']) && isHospitalScoped(hospitalId));
        allow create, update: if hasRole(['admin']) && isHospitalScoped(hospitalId);
        // Deliberate, narrow exception to "no hard deletes" — holidays are a
        // non-clinical scheduling record.
        allow delete: if hasRole(['admin']) && isHospitalScoped(hospitalId);
      }

      match /branches/{branchId} {
        allow read: if isSuperAdmin()
          || (hasRole(['admin']) && isHospitalScoped(hospitalId))
          || (hasRole(['office', 'reception', 'nurse', 'doctor', 'pharmacy', 'lab']) && isHospitalScoped(hospitalId));
        allow create, update: if isSuperAdmin() || (hasRole(['admin']) && isHospitalScoped(hospitalId));
        allow delete: if false;

        // doctors/{uid} — 1:1 with users/{uid}. Formerly flat `doctorProfiles`.
        match /doctors/{uid} {
          allow read: if isSuperAdmin()
            || (hasRole(['admin']) && isHospitalScoped(hospitalId))
            || (hasRole(['office', 'reception', 'nurse']) && isBranchScoped(hospitalId, branchId))
            || (isSignedIn() && request.auth.uid == uid)
            || hasRole(['patient']); // browsing doctors to book — platform-wide, not branch-scoped
          allow create: if hasRole(['admin']) && isHospitalScoped(hospitalId);
          allow update: if hasRole(['admin']) && isHospitalScoped(hospitalId);
          allow delete: if false;

          match /availabilityTemplates/{templateId} {
            allow read: if isSuperAdmin()
              || (hasRole(['admin']) && isHospitalScoped(hospitalId))
              || (hasRole(['office', 'reception']) && isBranchScoped(hospitalId, branchId))
              || (hasRole(['doctor']) && request.auth.uid == uid);
            allow create: if (hasRole(['admin']) && isHospitalScoped(hospitalId))
              || (hasRole(['doctor']) && request.auth.uid == uid && isBranchScoped(hospitalId, branchId));
            allow update: if (hasRole(['admin']) && isHospitalScoped(hospitalId))
              || (hasRole(['doctor']) && request.auth.uid == uid);
            allow delete: if false;
          }

          // Patients may read any APPROVED slot platform-wide (booking
          // browse) — ownership scope doesn't apply to browsing availability.
          match /slots/{slotId} {
            allow read: if isSuperAdmin()
              || (hasRole(['admin']) && isHospitalScoped(hospitalId))
              || (hasRole(['office', 'reception']) && isBranchScoped(hospitalId, branchId))
              || (hasRole(['doctor']) && request.auth.uid == uid)
              || (hasRole(['patient']) && resource.data.status == 'approved');
            allow create: if hasRole(['office']) && isBranchScoped(hospitalId, branchId);
            allow update: if (hasRole(['doctor']) && request.auth.uid == uid)
              || (hasRole(['office']) && isBranchScoped(hospitalId, branchId));
            allow delete: if false;
          }
        }

        match /availabilityRequests/{requestId} {
          allow read: if isSuperAdmin()
            || (hasRole(['admin']) && isHospitalScoped(hospitalId))
            || (hasRole(['office']) && isBranchScoped(hospitalId, branchId))
            || (hasRole(['doctor']) && resource.data.doctorId == request.auth.uid);
          allow create: if hasRole(['office']) && isBranchScoped(hospitalId, branchId);
          allow update: if hasRole(['doctor']) && resource.data.doctorId == request.auth.uid;
          allow delete: if false;
        }

        match /wards/{wardId} {
          allow read: if isSuperAdmin()
            || (hasRole(['admin']) && isHospitalScoped(hospitalId))
            || (hasRole(['office', 'reception', 'nurse', 'doctor']) && isBranchScoped(hospitalId, branchId));
          allow create: if hasRole(['admin']) && isHospitalScoped(hospitalId);
          allow update: if hasRole(['admin']) && isHospitalScoped(hospitalId);
          allow delete: if false;
        }

        match /rooms/{roomId} {
          allow read: if isSuperAdmin()
            || (hasRole(['admin']) && isHospitalScoped(hospitalId))
            || (hasRole(['office', 'reception', 'nurse', 'doctor']) && isBranchScoped(hospitalId, branchId));
          allow create: if hasRole(['admin']) && isHospitalScoped(hospitalId);
          allow update: if hasRole(['admin']) && isHospitalScoped(hospitalId);
          allow delete: if false;
        }

        match /beds/{bedId} {
          allow read: if isSuperAdmin()
            || (hasRole(['admin']) && isHospitalScoped(hospitalId))
            || (hasRole(['office', 'reception', 'nurse', 'doctor']) && isBranchScoped(hospitalId, branchId));
          // Admin creates the catalog and stops there. Office manages
          // day-to-day bed condition; Office/Doctor drive available ->
          // occupied when assigning a bed to an admission; Nurse does
          // ward-care status updates (cleaning/maintenance notes) but not
          // the admission-driven occupied<->available transition.
          allow create: if hasRole(['admin']) && isHospitalScoped(hospitalId);
          allow update: if hasRole(['office', 'doctor', 'nurse']) && isBranchScoped(hospitalId, branchId);
          allow delete: if false;
        }

        match /labTestMaster/{testId} {
          allow read: if isSuperAdmin()
            || (hasRole(['admin']) && isHospitalScoped(hospitalId))
            || (hasRole(['doctor', 'lab']) && isBranchScoped(hospitalId, branchId))
            || hasRole(['patient']);
          allow create: if hasRole(['admin']) && isHospitalScoped(hospitalId);
          allow update: if hasRole(['admin']) && isHospitalScoped(hospitalId);
          allow delete: if false;
        }

        match /medicines/{medicineId} {
          allow read: if isSuperAdmin()
            || (hasRole(['admin']) && isHospitalScoped(hospitalId))
            || (hasRole(['pharmacy']) && isBranchScoped(hospitalId, branchId));
          allow create: if (hasRole(['admin']) && isHospitalScoped(hospitalId))
            || (hasRole(['pharmacy']) && isBranchScoped(hospitalId, branchId));
          allow update: if (hasRole(['admin']) && isHospitalScoped(hospitalId))
            || (hasRole(['pharmacy']) && isBranchScoped(hospitalId, branchId));
          allow delete: if false;

          match /inventoryTransactions/{transactionId} {
            allow read: if isSuperAdmin()
              || (hasRole(['admin']) && isHospitalScoped(hospitalId))
              || (hasRole(['pharmacy']) && isBranchScoped(hospitalId, branchId));
            allow create: if hasRole(['pharmacy']) && isBranchScoped(hospitalId, branchId);
            allow update: if false; // append-only ledger
            allow delete: if false;
          }
        }

        // appointments — the center of the system. Vitals, check-in, and
        // consultationSummary are embedded fields (docs/10-collections-
        // schema.md §10.6), so field-level write restriction matters more
        // here than on any other collection.
        match /appointments/{appointmentId} {
          allow read: if isSuperAdmin()
            || (hasRole(['admin']) && isHospitalScoped(hospitalId))
            || (hasRole(['office', 'reception', 'nurse']) && isBranchScoped(hospitalId, branchId))
            || (hasRole(['doctor']) && resource.data.doctorId == request.auth.uid)
            || (hasRole(['patient']) && resource.data.patientId == request.auth.uid);

          allow create: if (hasRole(['patient']) && request.resource.data.patientId == request.auth.uid)
            || (hasRole(['reception', 'office']) && isBranchScoped(hospitalId, branchId));

          allow update: if (hasRole(['office']) && isBranchScoped(hospitalId, branchId))
            || (hasRole(['reception']) && isBranchScoped(hospitalId, branchId)
                && onlyFieldsChanged(['checkIn', 'status', 'updatedAt']))
            || (hasRole(['nurse']) && isBranchScoped(hospitalId, branchId)
                && resource.data.status == 'CHECKED_IN' && request.resource.data.status == 'VITALS_COMPLETED'
                && onlyFieldsChanged(['vitals', 'status', 'updatedAt']))
            || (hasRole(['doctor']) && resource.data.doctorId == request.auth.uid
                && onlyFieldsChanged(['consultationSummary', 'status', 'updatedAt']));

          allow delete: if false;
        }

        match /admissions/{id} {
          allow read: if isSuperAdmin()
            || (hasRole(['admin']) && isHospitalScoped(hospitalId))
            || (hasRole(['doctor', 'reception', 'office', 'nurse']) && isBranchScoped(hospitalId, branchId))
            || (hasRole(['patient']) && resource.data.patientId == request.auth.uid);
          allow create: if hasRole(['doctor']) && isBranchScoped(hospitalId, branchId);
          allow update: if (hasRole(['doctor']) && isBranchScoped(hospitalId, branchId)) // discharge
            || (hasRole(['office']) && isBranchScoped(hospitalId, branchId)
                && resource.data.status == 'pendingBedAssignment' && request.resource.data.status == 'admitted')
            || (hasRole(['nurse']) && isBranchScoped(hospitalId, branchId)
                && onlyFieldsChanged(['careNotes', 'updatedAt'])); // ward care, not bed/status
          allow delete: if false;
        }

        match /labOrders/{id} {
          allow read: if isSuperAdmin()
            || (hasRole(['admin']) && isHospitalScoped(hospitalId))
            || (hasRole(['doctor', 'lab', 'office']) && isBranchScoped(hospitalId, branchId))
            || (hasRole(['patient']) && resource.data.patientId == request.auth.uid);
          allow create: if hasRole(['doctor']) && isBranchScoped(hospitalId, branchId);
          allow update: if (hasRole(['lab']) && isBranchScoped(hospitalId, branchId))
            || (hasRole(['office']) && isBranchScoped(hospitalId, branchId)
                && resource.data.status == 'pendingPayment' && request.resource.data.status == 'pending');
          allow delete: if false;
        }

        match /prescriptions/{id} {
          allow read: if isSuperAdmin()
            || (hasRole(['admin']) && isHospitalScoped(hospitalId))
            || (hasRole(['doctor', 'pharmacy']) && isBranchScoped(hospitalId, branchId))
            || (hasRole(['patient']) && resource.data.patientId == request.auth.uid);
          allow create: if hasRole(['doctor']) && isBranchScoped(hospitalId, branchId);
          allow update: if hasRole(['pharmacy']) && isBranchScoped(hospitalId, branchId);
          allow delete: if false;
        }

        match /followUps/{id} {
          allow read: if isSuperAdmin()
            || (hasRole(['admin']) && isHospitalScoped(hospitalId))
            || (hasRole(['office', 'reception', 'doctor']) && isBranchScoped(hospitalId, branchId))
            || (hasRole(['patient']) && resource.data.patientId == request.auth.uid);
          allow create: if hasRole(['doctor']) && isBranchScoped(hospitalId, branchId);
          allow update: if hasRole(['doctor']) && isBranchScoped(hospitalId, branchId);
          allow delete: if false;
        }

        match /medicalCertificates/{id} {
          allow read: if isSuperAdmin()
            || (hasRole(['admin']) && isHospitalScoped(hospitalId))
            || (hasRole(['doctor']) && isBranchScoped(hospitalId, branchId))
            || (hasRole(['patient']) && resource.data.patientId == request.auth.uid);
          allow create: if hasRole(['doctor']) && isBranchScoped(hospitalId, branchId);
          allow update: if false;
          allow delete: if false;
        }

        match /referrals/{id} {
          allow read: if isSuperAdmin()
            || (hasRole(['admin']) && isHospitalScoped(hospitalId))
            || (hasRole(['doctor']) && isBranchScoped(hospitalId, branchId))
            || (hasRole(['patient']) && resource.data.patientId == request.auth.uid);
          allow create: if hasRole(['doctor']) && isBranchScoped(hospitalId, branchId);
          allow update: if false;
          allow delete: if false;
        }

        match /labReports/{id} {
          allow read: if isSuperAdmin()
            || (hasRole(['admin']) && isHospitalScoped(hospitalId))
            || (hasRole(['doctor', 'lab']) && isBranchScoped(hospitalId, branchId))
            || (hasRole(['patient']) && resource.data.patientId == request.auth.uid);
          allow create: if hasRole(['lab']) && isBranchScoped(hospitalId, branchId);
          allow update: if false; // append-only
          allow delete: if false;
        }

        match /medicineDispenses/{id} {
          allow read: if isSuperAdmin()
            || (hasRole(['admin']) && isHospitalScoped(hospitalId))
            || (hasRole(['pharmacy']) && isBranchScoped(hospitalId, branchId))
            || (hasRole(['patient']) && resource.data.patientId == request.auth.uid);
          allow create: if hasRole(['pharmacy']) && isBranchScoped(hospitalId, branchId);
          allow update: if hasRole(['pharmacy']) && isBranchScoped(hospitalId, branchId);
          allow delete: if false;
        }

        match /medicineLogs/{id} {
          allow read: if isSuperAdmin()
            || (hasRole(['admin']) && isHospitalScoped(hospitalId))
            || (hasRole(['doctor']) && isBranchScoped(hospitalId, branchId))
            || (hasRole(['patient']) && resource.data.patientId == request.auth.uid);
          allow create: if false; // dispenseMedicine only
          // FR-14.1 — patient marks their own dose taken/missed/skipped.
          allow update: if hasRole(['patient']) && resource.data.patientId == request.auth.uid
            && onlyFieldsChanged(['patientStatus', 'updatedAt']);
          allow delete: if false;
        }

        match /doctorMedicineOrders/{id} {
          allow read: if isSuperAdmin()
            || (hasRole(['admin']) && isHospitalScoped(hospitalId))
            || (hasRole(['doctor', 'pharmacy']) && isBranchScoped(hospitalId, branchId));
          allow create: if hasRole(['doctor']) && isBranchScoped(hospitalId, branchId);
          allow update: if false;
          allow delete: if false;
        }

        match /invoices/{id} {
          allow read: if isSuperAdmin()
            || (hasRole(['admin']) && isHospitalScoped(hospitalId))
            || (hasRole(['reception']) && isBranchScoped(hospitalId, branchId))
            || (hasRole(['patient']) && resource.data.patientId == request.auth.uid);
          allow create: if hasRole(['reception', 'admin']) && isHospitalScoped(hospitalId);
          allow update: if hasRole(['reception', 'admin']) && isHospitalScoped(hospitalId);
          allow delete: if false;

          match /payments/{paymentId} {
            allow read: if isSuperAdmin()
              || (hasRole(['admin']) && isHospitalScoped(hospitalId))
              || (hasRole(['reception']) && isBranchScoped(hospitalId, branchId));
            allow create: if hasRole(['reception', 'admin']) && isHospitalScoped(hospitalId);
            allow update: if false; // append-only ledger
            allow delete: if false;
          }
        }

        match /feedback/{id} {
          allow read: if isSuperAdmin()
            || (hasRole(['admin']) && isHospitalScoped(hospitalId))
            || (hasRole(['doctor']) && isBranchScoped(hospitalId, branchId))
            || (hasRole(['patient']) && resource.data.patientId == request.auth.uid);
          allow create: if false; // via submitFeedback callable only
          allow update: if hasRole(['admin']) && isHospitalScoped(hospitalId)
            && onlyFieldsChanged(['status', 'updatedAt']);
          allow delete: if false;
        }

        match /dailyStats/{id} {
          allow read: if isSuperAdmin() || (hasRole(['admin']) && isHospitalScoped(hospitalId));
          allow write: if false; // rollUpDailyStats scheduled function only
        }
      }
    }

    // healthUpdates/{id} is self-reported patient data with no branch/
    // hospital association at all (written directly by the patient, no
    // dispensing/consult context) — hospitalId is null, flat/ownership-only,
    // unlike medicineLogs (nested above — it's created by a branch-scoped
    // dispenseMedicine call and does carry hospitalId/branchId).
    match /healthUpdates/{id} {
      allow read: if isSuperAdmin() || (hasRole(['patient']) && resource.data.patientId == request.auth.uid);
      allow create: if hasRole(['patient']) && request.resource.data.patientId == request.auth.uid;
      allow update: if false; // append-only
      allow delete: if false;
    }

    // -------------------------------------------------------------------
    // Every other collection ships its rules with its own module — deny by
    // default until then.
    // -------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
