{
  "name": "functions",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "serve": "pnpm build && firebase emulators:start --only functions",
    "deploy": "pnpm --dir .. build:shared && pnpm build && node -e \"process.env.CI='true';require('child_process').execSync('firebase deploy --only functions',{stdio:'inherit'})\"",
    "typecheck": "tsc --noEmit",
    "seed:super-admin": "node scripts/seed-super-admin.mjs",
    "seed:demo": "node scripts/seed-demo-data.mjs"
  },
  "dependencies": {
    "@hms/shared": "workspace:*",
    "@hms/shared-server": "workspace:*",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  }
}
